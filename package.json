{
  "name": "analytics-backup-server",
  "version": "1.0.0",
  "description": "Backup analytics pixel endpoint for playable ads. Receives GET pixel pings and stores them in MongoDB.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:local": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongodb": "^6.8.0"
  }
}
